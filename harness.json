{
  "$comment": "harness v2 (SC-5859) — generated by `harness init`; change the template in ~/Development/harness, never this file",
  "version": 2,
  "stack": "ts-web",
  "tier": "A",
  "defaultBranch": "main",
  "riskPaths": [
    "**/auth/**",
    "**/billing/**",
    "**/payments/**",
    "**/migrations/**",
    "**/*.sql",
    ".env*",
    "**/secrets/**",
    "middleware.ts",
    "**/api/**/route.ts"
  ],
  "checks": {
    "fast": "npm run -s check:fast",
    "full": "npm run -s check:full",
    "ui": "npm run -s check:ui"
  },
  "tests": {
    "runners": [
      {
        "match": "e2e/**",
        "cmd": "npx playwright test {files}"
      },
      {
        "match": "**",
        "cmd": "npx vitest run {files}"
      }
    ]
  },
  "coverage": {
    "lcov": "coverage/lcov.info",
    "diffMin": 80
  },
  "routes": {
    "source": "auto",
    "viewports": [
      {
        "name": "desktop",
        "width": 1280,
        "height": 800
      },
      {
        "name": "tablet",
        "width": 820,
        "height": 1180
      },
      {
        "name": "mobile",
        "width": 390,
        "height": 844
      }
    ]
  },
  "review": {
    "enabled": true,
    "blockOn": "high",
    "maxFixAttempts": 2
  },
  "gapFiller": {
    "enabled": true,
    "maxAttempts": 1
  },
  "ci": {
    "provider": "none",
    "requiredChecks": []
  },
  "hooks": {
    "lint": true,
    "format": true,
    "types": true,
    "tests": true
  }
}
